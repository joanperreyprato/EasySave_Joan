<Window x:Class="EasySave.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasySave 3.0" 
        Height="600" 
        Width="1100"
        MinHeight="500"
        MinWidth="900"
        Background="{StaticResource BackgroundColor}"
        WindowStartupLocation="CenterScreen">

    <Border Margin="24" Style="{StaticResource PageShell}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Modern Header -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceMuted}"
                    CornerRadius="16" Padding="24,20" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="EasySave" FontSize="30" FontWeight="Bold" 
                                   Foreground="{StaticResource TextPrimary}"/>
                        <TextBlock x:Name="HeaderSubtitle" Text="Sauvegardes intelligentes et sécurisées" FontSize="13" 
                                   Foreground="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Border Background="{StaticResource AccentSoft}" CornerRadius="999" Padding="10,4" Margin="0,0,8,0">
                                <TextBlock Text="v3.0" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryColor}"/>
                            </Border>
                            <Border Background="{StaticResource NeutralSoft}" CornerRadius="999" Padding="10,4">
                                <TextBlock x:Name="HeaderBadgeFast" Text="Backups rapides" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="LblLanguage" Text="Langue" FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CbLanguage" Width="160" Height="44"
                                  Style="{StaticResource ModernComboBox}"
                                  Margin="12,0,0,0"
                                  SelectedValuePath="Tag"
                                  PreviewMouseLeftButtonDown="CbLanguage_PreviewMouseLeftButtonDown">
                            <ComboBoxItem Tag="en">English</ComboBoxItem>
                            <ComboBoxItem Tag="fr">Français</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content -->
            <TabControl Grid.Row="1" Style="{StaticResource ModernTabControl}">
                <TabItem Style="{StaticResource ModernTabItem}">
                    <TabItem.Header>
                        <TextBlock x:Name="TabJobsHeader" Text="Jobs" FontSize="15"/>
                    </TabItem.Header>
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock x:Name="JobsSectionTitle" Text="Tableau des sauvegardes" Style="{StaticResource SectionHeader}"/>
                            <TextBlock x:Name="JobsSectionDesc" Text="Gérez, démarrez et surveillez vos travaux en temps réel." Style="{StaticResource DescriptionText}"/>
                        </StackPanel>

                        <!-- Action Bar -->
                        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
                            <WrapPanel Orientation="Horizontal">
                                <Button x:Name="BtnAddJob" Content="+ Add Job" 
                                        Style="{StaticResource ModernButton}" 
                                        Margin="0,0,12,0" Width="150" Height="44"/>
                                <Button x:Name="BtnStartSelected" Content="▶ Start Selected" 
                                        Style="{StaticResource ModernButton}" 
                                        Margin="0,0,12,0" Width="170" Height="44"/>
                                <Button x:Name="BtnPauseSelected" Content="| | Pause Selected" 
                                        Style="{StaticResource ModernButton}" 
                                        Background="#F59E0B"
                                        Margin="0,0,12,0" Width="170" Height="44"/>
                                <Button x:Name="BtnStopSelected" Content="■ Stop Selected" 
                                        Style="{StaticResource ModernButton}" 
                                        Background="#EF4444"
                                        Width="160" Height="44"/>
                            </WrapPanel>
                        </Border>

                        <!-- Jobs List Card -->
                        <Border Grid.Row="2" Style="{StaticResource Card}">
                            <ListView x:Name="JobsList"
                                      Style="{StaticResource ModernListView}"
                                      SelectionMode="Single"
                                      ItemContainerStyle="{StaticResource ModernListViewItem}">
                                <ListView.View>
                                    
                                    <GridView ColumnHeaderContainerStyle="{StaticResource ModernGridViewHeader}">
                                        <GridViewColumn Width="44">
                                            <GridViewColumn.Header>
                                                <CheckBox x:Name="CbSelectAll"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Checked="CbSelectAll_Checked"
                                                          Unchecked="CbSelectAll_Unchecked"
                                                          ToolTip="Tout sélectionner"/>
                                            </GridViewColumn.Header>
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Width="180">
                                            <GridViewColumn.Header>
                                                <TextBlock x:Name="ColNameHeader" Text="Nom" Style="{StaticResource TableHeaderText}"/>
                                            </GridViewColumn.Header>
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" 
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimary}"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Width="200">
                                            <GridViewColumn.Header>
                                                <TextBlock x:Name="ColSourceHeader" Text="Source" Style="{StaticResource TableHeaderText}"/>
                                            </GridViewColumn.Header>
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Source}" 
                                                               Foreground="{StaticResource TextSecondary}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Width="200">
                                            <GridViewColumn.Header>
                                                <TextBlock x:Name="ColTargetHeader" Text="Cible" Style="{StaticResource TableHeaderText}"/>
                                            </GridViewColumn.Header>
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Destination}" 
                                                               Foreground="{StaticResource TextSecondary}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Width="110">
                                            <GridViewColumn.Header>
                                                <TextBlock x:Name="ColStateHeader" Text="État" Style="{StaticResource TableHeaderText}"/>
                                            </GridViewColumn.Header>
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="999" Padding="10,4" HorizontalAlignment="Left" Background="{StaticResource NeutralSoft}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <!-- English states -->
                                                                    <DataTrigger Binding="{Binding State}" Value="Running">
                                                                        <Setter Property="Background" Value="{StaticResource SuccessSoft}"/>
                                                                        <Setter Property="BorderBrush" Value="{StaticResource SuccessColor}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding State}" Value="Paused">
                                                                        <Setter Property="Background" Value="#FEF3C7"/>
                                                                        <Setter Property="BorderBrush" Value="#F59E0B"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding State}" Value="Stopped">
                                                                        <Setter Property="Background" Value="{StaticResource NeutralSoft}"/>
                                                                        <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding State}" Value="Completed">
                                                                        <Setter Property="Background" Value="{StaticResource SuccessSoft}"/>
                                                                        <Setter Property="BorderBrush" Value="{StaticResource SuccessColor}"/>
                                                                    </DataTrigger>
                                                                    <!-- French states -->
                                                                    <DataTrigger Binding="{Binding State}" Value="En cours">
                                                                        <Setter Property="Background" Value="{StaticResource SuccessSoft}"/>
                                                                        <Setter Property="BorderBrush" Value="{StaticResource SuccessColor}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding State}" Value="En pause">
                                                                        <Setter Property="Background" Value="#FEF3C7"/>
                                                                        <Setter Property="BorderBrush" Value="#F59E0B"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding State}" Value="Arrêté">
                                                                        <Setter Property="Background" Value="{StaticResource NeutralSoft}"/>
                                                                        <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding State}" Value="Terminé">
                                                                        <Setter Property="Background" Value="{StaticResource SuccessSoft}"/>
                                                                        <Setter Property="BorderBrush" Value="{StaticResource SuccessColor}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding State}" FontWeight="SemiBold" FontSize="12">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <!-- English states -->
                                                                        <DataTrigger Binding="{Binding State}" Value="Running">
                                                                            <Setter Property="Foreground" Value="#15803D"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding State}" Value="Paused">
                                                                            <Setter Property="Foreground" Value="#D97706"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding State}" Value="Stopped">
                                                                            <Setter Property="Foreground" Value="#475569"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding State}" Value="Completed">
                                                                            <Setter Property="Foreground" Value="#15803D"/>
                                                                        </DataTrigger>
                                                                        <!-- French states -->
                                                                        <DataTrigger Binding="{Binding State}" Value="En cours">
                                                                            <Setter Property="Foreground" Value="#15803D"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding State}" Value="En pause">
                                                                            <Setter Property="Foreground" Value="#D97706"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding State}" Value="Arrêté">
                                                                            <Setter Property="Foreground" Value="#475569"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding State}" Value="Terminé">
                                                                            <Setter Property="Foreground" Value="#15803D"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Width="120">
                                            <GridViewColumn.Header>
                                                <TextBlock x:Name="ColProgressHeader" Text="Progression" Style="{StaticResource TableHeaderText}"/>
                                            </GridViewColumn.Header>
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <ProgressBar Value="{Binding Progress}" 
                                                                     Width="60" 
                                                                     Height="18"
                                                                     Minimum="0" 
                                                                     Maximum="100"
                                                                     Foreground="{StaticResource PrimaryColor}"
                                                                     Background="{StaticResource SurfaceMuted}"
                                                                     BorderBrush="{StaticResource BorderColor}"
                                                                     BorderThickness="1"/>
                                                        <TextBlock Text="{Binding Progress, StringFormat={}{0:F0}%}" 
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Margin="6,0,0,0"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{StaticResource TextSecondary}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Width="220">
                                            <GridViewColumn.Header>
                                                <TextBlock x:Name="ColActionsHeader" Text="Actions" Style="{StaticResource TableHeaderText}"/>
                                            </GridViewColumn.Header>
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="▶" 
                                                                Width="28" Height="28" 
                                                                Margin="0,0,4,0"
                                                                FontSize="10"
                                                                Background="{StaticResource PrimaryColor}"
                                                                Foreground="White"
                                                                BorderThickness="0"
                                                                Cursor="Hand"
                                                                Click="BtnPlayJob_Click"
                                                                Tag="{Binding Name}"
                                                                ToolTip="Play">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border Background="{TemplateBinding Background}" 
                                                                                        CornerRadius="6" 
                                                                                        Padding="4">
                                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                </Border>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Opacity" Value="0.8"/>
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Button Content="| |" 
                                                                Width="28" Height="28" 
                                                                Margin="0,0,4,0"
                                                                FontSize="10"
                                                                Background="#F59E0B"
                                                                Foreground="White"
                                                                BorderThickness="0"
                                                                Cursor="Hand"
                                                                Click="BtnPauseJob_Click"
                                                                Tag="{Binding Name}"
                                                                ToolTip="Pause">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border Background="{TemplateBinding Background}" 
                                                                                        CornerRadius="6" 
                                                                                        Padding="4">
                                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                </Border>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Opacity" Value="0.8"/>
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Button Content="■" 
                                                                Width="28" Height="28"
                                                                Margin="0,0,4,0"
                                                                FontSize="10"
                                                                Background="#EF4444"
                                                                Foreground="White"
                                                                BorderThickness="0"
                                                                Cursor="Hand"
                                                                Click="BtnStopJob_Click"
                                                                Tag="{Binding Name}"
                                                                ToolTip="Stop">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border Background="{TemplateBinding Background}" 
                                                                                        CornerRadius="6" 
                                                                                        Padding="4">
                                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                </Border>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Opacity" Value="0.8"/>
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Button Content="🔓" 
                                                                Width="28" Height="28"
                                                                FontSize="10"
                                                                Background="#0EA5E9"
                                                                Foreground="White"
                                                                BorderThickness="0"
                                                                Cursor="Hand"
                                                                Click="BtnDecryptJob_Click"
                                                                Tag="{Binding Name}"
                                                                ToolTip="Decrypt">
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border Background="{TemplateBinding Background}" 
                                                                                        CornerRadius="6" 
                                                                                        Padding="4">
                                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                </Border>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Opacity" Value="0.8"/>
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </Border>

                        <!-- Modern Status Bar -->
                        <Border Grid.Row="3" Background="{StaticResource SurfaceMuted}" CornerRadius="12" Margin="0,16,0,0" Padding="4">
                            <StatusBar Style="{StaticResource ModernStatusBar}" Background="Transparent" BorderThickness="0">
                                <StatusBarItem>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="●" Foreground="{StaticResource SuccessColor}" 
                                                   FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="StatusText" Text="Prêt" 
                                                   FontSize="13" Foreground="{StaticResource TextSecondary}"/>
                                    </StackPanel>
                                </StatusBarItem>
                            </StatusBar>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem x:Name="TabEncryption" Style="{StaticResource ModernTabItem}">
                    <TabItem.Header>
                        <TextBlock Text="Chiffrement" FontSize="15"/>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                        <StackPanel MaxWidth="640" HorizontalAlignment="Center">
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock x:Name="SecuritySectionTitle" Text="Sécurité &amp; chiffrement" Style="{StaticResource SectionHeader}"/>
                                <TextBlock x:Name="SecuritySectionDesc" Text="Protégez vos sauvegardes avec des extensions et un code personnalisés." Style="{StaticResource DescriptionText}"/>
                            </StackPanel>

                            <!-- Encryption Key Card -->
                            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock x:Name="LblEncryptionHeader" 
                                           Text="Code de chiffrement" 
                                           Style="{StaticResource SectionHeader}"/>
                                    <PasswordBox x:Name="PbEncryptionKey" 
                                             Style="{StaticResource ModernPasswordBox}"
                                             Margin="0,0,0,12"/>
                                    <TextBlock x:Name="TbEncryptionDesc" 
                                           Text="Entrez un code ici. Lors du lancement des travaux, vous serez invité à chiffrer ou non." 
                                           Style="{StaticResource DescriptionText}"/>
                                </StackPanel>
                            </Border>

                            <!-- File Extensions Card -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock x:Name="EncryptionExtensionsTitle" Text="Extensions à chiffrer" 
                                           Style="{StaticResource SectionHeader}"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <TextBox x:Name="TbNewExt" 
                                             Style="{StaticResource ModernTextBox}"
                                             Width="320"
                                             VerticalContentAlignment="Center"
                                             Margin="0,0,12,0"/>
                                        <Button x:Name="BtnAddExt" 
                                            Content="+ Ajouter" 
                                            Style="{StaticResource SecondaryButton}"
                                            Width="110" Height="44" Margin="0,0,8,0"/>
                                        <Button x:Name="BtnRemoveExt" 
                                            Content="- Supprimer" 
                                            Style="{StaticResource DangerButton}"
                                            Width="130" Height="44"/>
                                    </StackPanel>

                                    <ListBox x:Name="LbEncryptionTypes" 
                                         Style="{StaticResource ModernListBox}"
                                         Height="180" 
                                         Margin="0,0,0,12"/>

                                    <TextBlock x:Name="LblEncryptionListDesc" 
                                           Text="Liste des extensions qui seront chiffrées." 
                                           Style="{StaticResource DescriptionText}"
                                           HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Business Software Tab -->
                <TabItem x:Name="TabSettings" Style="{StaticResource ModernTabItem}">
                    <TabItem.Header>
                        <TextBlock x:Name="TabSettingsHeader" Text="Paramètres" FontSize="15"/>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                        <StackPanel MaxWidth="640" HorizontalAlignment="Center">
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock x:Name="SettingsSectionTitle" Text="Paramètres généraux" Style="{StaticResource SectionHeader}"/>
                                <TextBlock x:Name="SettingsSectionDesc" Text="Configurez les paramètres de bande passante, les extensions prioritaires et les logiciels métiers." Style="{StaticResource DescriptionText}"/>
                            </StackPanel>

                            <!-- Remote Logging Configuration Card -->
                            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock x:Name="LblRemoteLoggingHeader" 
                                           Text="🌐 Serveur de logs distant" 
                                           Style="{StaticResource SectionHeader}"/>
                                    <TextBlock x:Name="LblRemoteLoggingDesc" 
                                           Text="Envoyez les logs vers un serveur centralisé (Docker) en plus du stockage local."
                                           Style="{StaticResource DescriptionText}"
                                           Margin="0,0,0,16"
                                           TextWrapping="Wrap"/>

                                    <CheckBox x:Name="CbEnableRemoteLogging" 
                                          Content="Activer le logging distant"
                                          FontSize="13"
                                          Margin="0,0,0,16"/>

                                    <StackPanel x:Name="PnlRemoteLoggingSettings" Opacity="0.5" IsEnabled="False">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <TextBlock x:Name="LblRemoteLoggingHostLabel" Text="Adresse du serveur :" 
                                                   VerticalAlignment="Center" 
                                                   Width="160"
                                                   Margin="0,0,12,0"/>
                                            <TextBox x:Name="TbRemoteLoggingHost" 
                                                 Width="200" 
                                                 Style="{StaticResource ModernTextBox}"
                                                 Text="localhost"
                                                 VerticalContentAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <TextBlock x:Name="LblRemoteLoggingPortLabel" Text="Port :" 
                                                   VerticalAlignment="Center" 
                                                   Width="160"
                                                   Margin="0,0,12,0"/>
                                            <TextBox x:Name="TbRemoteLoggingPort" 
                                                 Width="120" 
                                                 Style="{StaticResource ModernTextBox}"
                                                 Text="5555"
                                                 VerticalContentAlignment="Center"/>
                                        </StackPanel>

                                        <CheckBox x:Name="CbKeepLocalLogs" 
                                              Content="Conserver également les logs locaux"
                                              FontSize="13"
                                              IsChecked="True"
                                              Margin="0,0,0,12"/>

                                        <Button x:Name="BtnTestConnection" 
                                            Content="🔌 Tester la connexion"
                                            Style="{StaticResource OutlineButton}"
                                            Width="180" 
                                            Height="44"
                                            HorizontalAlignment="Left"
                                            Margin="0,8,0,0"/>
                                    </StackPanel>

                                    <Border x:Name="RemoteLoggingStatusBorder" 
                                        CornerRadius="8" 
                                        Padding="12" 
                                        Margin="0,16,0,0"
                                        Background="{StaticResource NeutralSoft}"
                                        BorderBrush="{StaticResource BorderColor}"
                                        BorderThickness="1"
                                        Visibility="Collapsed">
                                        <TextBlock x:Name="TbRemoteLoggingStatus" 
                                               Text="Configuration enregistrée"
                                               FontSize="12"
                                               Foreground="{StaticResource TextSecondary}"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Large file threshold setting -->
                            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock x:Name="LblBandwidthHeader" 
                                           Text="Paramètre de bande passante" 
                                           Style="{StaticResource SectionHeader}"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="LblLargeFileThreshold" 
                                               Text="Seuil fichiers volumineux (Ko) :" 
                                               VerticalAlignment="Center" 
                                               Margin="0,0,12,0"/>
                                        <TextBox x:Name="TbLargeFileThresholdKb" 
                                             Width="120" 
                                             Style="{StaticResource ModernTextBox}" 
                                             Foreground="{StaticResource TextPrimary}" 
                                             Background="White" 
                                             ToolTip="0 pour désactiver la restriction" 
                                             PreviewTextInput="TbLargeFileThresholdKb_PreviewTextInput" 
                                             DataObject.Pasting="TbLargeFileThresholdKb_Pasting" />
                                        <TextBlock x:Name="LblBandwidthDesc" 
                                               Text="(Un seul transfert simultané si fichier > seuil)" 
                                               TextWrapping="Wrap" 
                                               Margin="12,0,0,0" 
                                               VerticalAlignment="Center" 
                                               Style="{StaticResource DescriptionText}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Priority File Extensions Card -->
                            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock x:Name="LblPriorityExtensionsHeader" 
                                           Text="Extensions prioritaires" 
                                           Style="{StaticResource SectionHeader}"/>
                                    <TextBlock x:Name="LblPriorityExtensionsDesc" 
                                           Text="Les fichiers avec ces extensions seront traités en priorité. Aucun fichier non prioritaire ne sera copié tant qu'il reste des fichiers prioritaires en attente."
                                           Style="{StaticResource DescriptionText}"
                                           Margin="0,0,0,16"
                                           TextWrapping="Wrap"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <TextBox x:Name="TbNewPriorityExt" 
                                             Style="{StaticResource ModernTextBox}"
                                             Width="320" 
                                             Height="44"
                                             VerticalContentAlignment="Center"
                                             Margin="0,0,12,0"/>
                                        <Button x:Name="BtnAddPriorityExt" 
                                            Content="+ Ajouter" 
                                            Style="{StaticResource SecondaryButton}"
                                            Width="110" Height="44" Margin="0,0,8,0"/>
                                        <Button x:Name="BtnRemovePriorityExt" 
                                            Content="- Supprimer" 
                                            Style="{StaticResource DangerButton}"
                                            Width="130" Height="44"/>
                                    </StackPanel>

                                    <ListBox x:Name="LbPriorityExtensions" 
                                         Style="{StaticResource ModernListBox}"
                                         Height="180" 
                                         Margin="0,0,0,12"/>

                                    <TextBlock x:Name="LblPriorityExtensionsHint" 
                                           Text="Exemple : .pdf, .docx, .xlsx (les extensions critiques pour votre activité)" 
                                           Style="{StaticResource DescriptionText}"
                                           HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Business Software Status Card -->
                            <Border Style="{StaticResource Card}" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock x:Name="LblBusinessSectionTitle" 
                                           Text="Logiciels métiers" 
                                           Style="{StaticResource SectionHeader}"
                                           Margin="0,0,0,8"/>
                                    <TextBlock x:Name="LblBusinessSectionDesc" 
                                           Text="Bloquer les sauvegardes si un logiciel métier est en cours d'exécution."
                                           Style="{StaticResource DescriptionText}"
                                           Margin="0,0,0,16"
                                           TextWrapping="Wrap"/>

                                    <TextBlock x:Name="LblBusinessStatusHeader" 
                                           Text="État actuel" 
                                           Style="{StaticResource SectionHeader}"
                                           FontSize="14"
                                           Margin="0,0,0,8"/>
                                    <Border x:Name="BusinessStatusBorder" 
                                        CornerRadius="12" 
                                        Padding="16" 
                                        Margin="0,8,0,0"
                                        Background="{StaticResource SuccessSoft}"
                                        BorderBrush="{StaticResource SuccessColor}"
                                        BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock x:Name="TbBusinessStatus" 
                                                   Text="✓ Aucun logiciel métier détecté"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"
                                                   Foreground="#15803D"/>
                                            <TextBlock x:Name="TbBusinessStatusDetail"
                                                   Text="Les sauvegardes sont autorisées"
                                                   FontSize="12"
                                                   Foreground="#4D7C0F"
                                                   Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Button x:Name="BtnRefreshStatus" 
                                        Content="🔄 Actualiser"
                                        Style="{StaticResource OutlineButton}"
                                        Width="150" 
                                        Height="44"
                                        Margin="0,12,0,0"
                                        HorizontalAlignment="Left"/>
                                </StackPanel>
                            </Border>

                            <!-- Business Software List Card -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock x:Name="LblBusinessSoftwareHeader" 
                                           Text="Processus surveillés" 
                                           Style="{StaticResource SectionHeader}"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                        <TextBox x:Name="TbNewProcess" 
                                             Style="{StaticResource ModernTextBox}"
                                             Width="320" 
                                             VerticalContentAlignment="Center"
                                             Margin="0,0,12,0"/>
                                        <Button x:Name="BtnAddProcess" 
                                            Content="+ Ajouter" 
                                            Style="{StaticResource SecondaryButton}"
                                            Width="110" Height="44" Margin="0,0,8,0"/>
                                        <Button x:Name="BtnRemoveProcess" 
                                            Content="- Supprimer" 
                                            Style="{StaticResource DangerButton}"
                                            Width="130" Height="44"/>
                                    </StackPanel>

                                    <ListBox x:Name="LbBusinessProcesses" 
                                         Style="{StaticResource ModernListBox}"
                                         Height="180" 
                                         Margin="0,0,0,12"/>

                                    <TextBlock x:Name="TbBusinessHint" 
                                           Text="Exemple : CalculatorApp (pour la calculatrice), notepad (pour le bloc-notes)" 
                                           Style="{StaticResource DescriptionText}"/>

                                    <!-- Quick Add Buttons -->
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button x:Name="BtnAddCalc" 
                                            Content="Calculatrice" 
                                            Style="{StaticResource OutlineButton}"
                                            Width="130" Height="36" 
                                            Margin="0,0,8,0"
                                            FontSize="12"/>
                                        <Button x:Name="BtnAddNotepad" 
                                            Content="Bloc-notes" 
                                            Style="{StaticResource OutlineButton}"
                                            Width="130" Height="36"
                                            FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
    </Border>
</Window>
