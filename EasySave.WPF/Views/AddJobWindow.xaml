<Window x:Class="EasySave.WPF.Views.AddJobWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding [menu_create]}" Height="340" Width="520"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Name -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [job_name]}" VerticalAlignment="Center" Margin="0,6"/>
        <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="NameBox" Margin="0,6"/>

        <!-- Source -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding [job_source]}" VerticalAlignment="Center" Margin="0,6"/>
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="SourceBox" Margin="0,6,6,6"/>
        <Button Grid.Row="1" Grid.Column="2" Content="📂" Width="32" Click="BrowseSource_Click"
                ToolTip="{Binding [tip_browse]}" Padding="4" Margin="0,6"/>

        <!-- Target -->
        <TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding [job_target]}" VerticalAlignment="Center" Margin="0,6"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TargetBox" Margin="0,6,6,6"/>
        <Button Grid.Row="2" Grid.Column="2" Content="📂" Width="32" Click="BrowseTarget_Click"
                ToolTip="{Binding [tip_browse]}" Padding="4" Margin="0,6"/>

        <!-- Type -->
        <TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding [job_type]}" VerticalAlignment="Center" Margin="0,6"/>
        <StackPanel Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                    Orientation="Horizontal" Margin="0,6">
            <RadioButton x:Name="FullRadio" Content="{Binding [job_type_full]}" IsChecked="True" Margin="0,0,20,0"
                         Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
            <RadioButton x:Name="DiffRadio" Content="{Binding [job_type_differential]}"
                         Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Error message -->
        <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                   x:Name="ErrorText" Foreground="{DynamicResource ErrorBrush}"
                   TextWrapping="Wrap" Margin="0,4" Visibility="Collapsed"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3"
                    Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{Binding [btn_cancel]}" Width="90" Click="Cancel_Click"
                    Margin="0,0,10,0" Padding="8,6"
                    Background="{DynamicResource BorderBrush}"
                    Foreground="{DynamicResource TextBrush}" BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Content="{Binding [btn_create]}" Width="110" Click="Create_Click"
                    Padding="8,6" Background="{DynamicResource PrimaryBrush}" Foreground="White" BorderThickness="0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>
