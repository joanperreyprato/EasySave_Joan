<Window x:Class="EasySave.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EasySave.WPF.ViewModels"
        Title="EasySave v2.0 — ProSoft"
        Height="680" Width="1050" MinHeight="550" MinWidth="800"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <!-- Button Style -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background"   Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"      Value="16,8"/>
            <Setter Property="Margin"       Value="4"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
        </Style>

        <!-- TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background"    Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground"    Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush"   Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding"       Value="6,4"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Label/TextBlock Style -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize"   Value="13"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"          Value="{DynamicResource BackgroundBrush}"/>
            <Setter Property="Foreground"          Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush"         Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness"     Value="0,0,1,1"/>
            <Setter Property="Padding"             Value="8,6"/>
            <Setter Property="FontWeight"          Value="SemiBold"/>
        </Style>

        <!-- DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background"          Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground"          Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush"         Value="{DynamicResource BorderBrush}"/>
            <Setter Property="RowBackground"       Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource BackgroundBrush}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="SelectionMode"       Value="Single"/>
            <Setter Property="CanUserAddRows"      Value="False"/>
            <Setter Property="CanUserDeleteRows"   Value="False"/>
            <Setter Property="HeadersVisibility"   Value="Column"/>
            <Setter Property="FontSize"            Value="13"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>   <!-- Header bar -->
            <RowDefinition Height="*"/>    <!-- Content -->
            <RowDefinition Height="Auto"/> <!-- Settings panel -->
            <RowDefinition Height="30"/>   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ── Header ─────────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="{DynamicResource PrimaryBrush}">
            <Grid Margin="16,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="💾 EasySave" FontSize="20" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text=": EasySave" FontSize="20" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text=" v3.0" FontSize="14" Foreground="#BBDEFB"
                               VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Content="{Binding CurrentLanguageText}" Style="{StaticResource PrimaryButton}"
                            Background="#1565C0" Command="{Binding ToggleLanguageCommand}"
                            ToolTip="Switch language / Changer la langue"/>
                    <Button Content="{Binding ThemeButtonText}" Style="{StaticResource PrimaryButton}"
                            Background="#1565C0" Command="{Binding ToggleThemeCommand}"
                            ToolTip="Toggle dark/light theme"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Main content ───────────────────────────────────────────────── -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Toolbar row 1: job management -->
                <RowDefinition Height="Auto"/> <!-- Toolbar row 2: play/pause/stop (v3.0) -->
                <RowDefinition Height="*"/>    <!-- Job list -->
                <RowDefinition Height="Auto"/> <!-- Progress detail -->
            </Grid.RowDefinitions>

            <!-- Toolbar Row 1: Job management -->
            <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                <Button Content="{Binding [btn_new_job]}" Style="{StaticResource PrimaryButton}"
                        Click="NewJobButton_Click" IsEnabled="{Binding IsNotBusy}"/>
                <Button Content="{Binding [btn_run_selected]}" Style="{StaticResource PrimaryButton}"
                        Command="{Binding RunSelectedJobsCommand}"/>
                <Button Content="{Binding [btn_run_all]}" Style="{StaticResource PrimaryButton}"
                        Command="{Binding RunAllJobsCommand}"/>
                <Button Content="{Binding [btn_delete]}" Style="{StaticResource DangerButton}"
                        Command="{Binding DeleteJobCommand}"/>
            </WrapPanel>

            <!-- Toolbar Row 2: Play/Pause/Stop controls (v3.0) -->
            <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                <!-- Per-job -->
                <TextBlock Text="Job: " VerticalAlignment="Center" Margin="0,0,4,0"
                           Foreground="{DynamicResource SubtextBrush}" FontSize="12"/>
                <Button Content="▶ Play"  Style="{StaticResource PrimaryButton}" Background="#2E7D32"
                        Command="{Binding ResumeJobCommand}" ToolTip="Resume selected job"/>
                <Button Content="⏸ Pause" Style="{StaticResource PrimaryButton}" Background="#E65100"
                        Command="{Binding PauseJobCommand}"  ToolTip="Pause selected job"/>
                <Button Content="⏹ Stop"  Style="{StaticResource DangerButton}"
                        Command="{Binding StopJobCommand}"   ToolTip="Stop selected job"/>

                <Separator Margin="8,0" Background="{DynamicResource BorderBrush}" Width="1" Height="22"/>

                <!-- Global -->
                <TextBlock Text="All: " VerticalAlignment="Center" Margin="0,0,4,0"
                           Foreground="{DynamicResource SubtextBrush}" FontSize="12"/>
                <Button Content="▶▶ Play All"  Style="{StaticResource PrimaryButton}" Background="#2E7D32"
                        Command="{Binding ResumeAllCommand}" ToolTip="Resume all jobs"/>
                <Button Content="⏸⏸ Pause All" Style="{StaticResource PrimaryButton}" Background="#E65100"
                        Command="{Binding PauseAllCommand}"  ToolTip="Pause all jobs"/>
                <Button Content="⏹⏹ Stop All"  Style="{StaticResource DangerButton}"
                        Command="{Binding StopAllCommand}"   ToolTip="Stop all jobs"/>
            </WrapPanel>

            <!-- Job DataGrid -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4">
                <DataGrid x:Name="JobsGrid" ItemsSource="{Binding Jobs}"
                          SelectedItem="{Binding SelectedJob}" SelectionChanged="JobsGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="36"/>
                        
                        <DataGridTextColumn Binding="{Binding Name}" Width="200" IsReadOnly="True">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{Binding DataContext.[job_name], RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>

                        <DataGridTextColumn Binding="{Binding TypeText}" Width="100" IsReadOnly="True">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{Binding DataContext.[job_type], RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>

                        <DataGridTextColumn Binding="{Binding SourceDirectory}" Width="*" IsReadOnly="True">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{Binding DataContext.[job_source], RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>

                        <DataGridTextColumn Binding="{Binding TargetDirectory}" Width="*" IsReadOnly="True">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{Binding DataContext.[job_target], RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>

                        <DataGridTextColumn Binding="{Binding StatusText}" Width="110" IsReadOnly="True">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{Binding DataContext.[status_active], RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        
                        <DataGridTemplateColumn Width="160">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="Progress"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <ProgressBar Value="{Binding Progress}" Maximum="100"
                                                     Height="18" Minimum="0"
                                                     Foreground="{DynamicResource PrimaryBrush}"/>
                                        <TextBlock Text="{Binding Progress, StringFormat={}{0:0}%}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="11" FontWeight="SemiBold"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Detail row for selected running job -->
            <Border Grid.Row="2" Margin="0,8,0,0" Padding="10"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="{Binding [info_backing_up]}"/>
                    <TextBlock Text="{Binding SelectedJob.Name, StringFormat='Job: {0}'}"
                               Foreground="{DynamicResource SubtextBrush}"/>
                    <TextBlock Text="{Binding SelectedJob.RemainingFiles, StringFormat='Files remaining: {0}'}"
                               Foreground="{DynamicResource SubtextBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ── Settings Panel ─────────────────────────────────────────────── -->
        <Expander Grid.Row="2" Header="{Binding [menu_settings]}" Margin="12,0,12,6"
                  Background="{DynamicResource SurfaceBrush}"
                  Foreground="{DynamicResource TextBrush}"
                  BorderBrush="{DynamicResource BorderBrush}">
            <Grid Margin="12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Business Software -->
                <TextBlock Grid.Column="0" Text="{Binding [lbl_business_software]}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox   Grid.Column="1" Text="{Binding BusinessSoftwareName, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="Process name to block (e.g. notepad, calc)"/>

                <!-- Encryption extensions -->
                <TextBlock Grid.Column="3" Text="{Binding [lbl_encrypt_extensions]}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox   Grid.Column="4" Text="{Binding EncryptionExtensions, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="Comma-separated extensions to encrypt (e.g. .docx, .xlsx)"/>

                <!-- Priority extensions (v3.0) -->
                <TextBlock Grid.Column="6" Text="{Binding [lbl_priority_extensions]}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox   Grid.Column="7" Text="{Binding PriorityExtensions, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="Extensions transferred first (e.g. .txt, .xml)"/>

                <!-- Large file threshold (v3.0) -->
                <TextBlock Grid.Column="9" Text="{Binding [lbl_large_file_kb]}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox   Grid.Column="10" Text="{Binding LargeFileSizeKb, UpdateSourceTrigger=PropertyChanged}"
                           ToolTip="Max size (Ko) for parallel transfer (default: 1024)"/>

                <!-- Log Format -->
                <TextBlock Grid.Column="12" Text="{Binding [settings_log_format]}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox  Grid.Column="13" x:Name="LogFormatCombo" SelectionChanged="LogFormatCombo_SelectionChanged"
                           SelectedIndex="0" VerticalAlignment="Center">
                    <ComboBoxItem Content="JSON"/>
                    <ComboBoxItem Content="XML"/>
                </ComboBox>

                <Button Grid.Column="14" Content="{Binding [lbl_save]}" Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveSettingsCommand}" VerticalAlignment="Center" Margin="16,0,0,0"/>
            </Grid>
        </Expander>

        <!-- ── Status bar ─────────────────────────────────────────────────── -->
        <Border Grid.Row="3" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusMessage}" Margin="12,0"
                       VerticalAlignment="Center" Foreground="{DynamicResource SubtextBrush}"
                       FontSize="12"/>
        </Border>
    </Grid>

</Window>
