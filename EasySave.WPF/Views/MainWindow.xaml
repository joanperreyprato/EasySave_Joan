<Window x:Class="EasySave.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasySave v3.0 — ProSoft"
        Height="720" Width="1100" MinHeight="580" MinWidth="860"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- ── Icon Button (sidebar) ───────────────────────────────────────── -->
        <Style x:Key="SideBtn" TargetType="Button">
            <Setter Property="Background"     Value="Transparent"/>
            <Setter Property="Foreground"     Value="{DynamicResource SubtextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"        Value="14,10"/>
            <Setter Property="Cursor"         Value="Hand"/>
            <Setter Property="FontSize"       Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}"
                                Margin="4,2">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Primary Action Button ──────────────────────────────────────── -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background"     Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="Foreground"     Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"        Value="14,7"/>
            <Setter Property="Margin"         Value="3,2"/>
            <Setter Property="Cursor"         Value="Hand"/>
            <Setter Property="FontSize"       Value="12"/>
            <Setter Property="FontWeight"     Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GreenButton"  TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#16A34A"/>
        </Style>
        <Style x:Key="OrangeButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{DynamicResource PauseBrush}"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{DynamicResource ErrorBrush}"/>
        </Style>

        <!-- ── TextBox ────────────────────────────────────────────────────── -->
        <Style TargetType="TextBox">
            <Setter Property="Background"     Value="{DynamicResource Surface2Brush}"/>
            <Setter Property="Foreground"     Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush"    Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"        Value="8,5"/>
            <Setter Property="CaretBrush"     Value="{DynamicResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── ComboBox ───────────────────────────────────────────────────── -->
        <Style TargetType="ComboBox">
            <Setter Property="Background"  Value="{DynamicResource Surface2Brush}"/>
            <Setter Property="Foreground"  Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Padding"     Value="8,4"/>
            <Setter Property="Height"      Value="30"/>
        </Style>

        <!-- ── TextBlock global ───────────────────────────────────────────── -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize"   Value="13"/>
        </Style>

        <!-- ── DataGrid column headers ────────────────────────────────────── -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"      Value="{DynamicResource Surface2Brush}"/>
            <Setter Property="Foreground"      Value="{DynamicResource SubtextBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding"         Value="12,8"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
        </Style>

        <!-- ── DataGrid rows ──────────────────────────────────────────────── -->
        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectedRowBrush}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── DataGrid ───────────────────────────────────────────────────── -->
        <Style TargetType="DataGrid">
            <Setter Property="Background"              Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground"              Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush"             Value="{DynamicResource BorderBrush}"/>
            <Setter Property="RowBackground"           Value="Transparent"/>
            <Setter Property="GridLinesVisibility"     Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="AutoGenerateColumns"     Value="False"/>
            <Setter Property="SelectionMode"           Value="Single"/>
            <Setter Property="CanUserAddRows"          Value="False"/>
            <Setter Property="CanUserDeleteRows"       Value="False"/>
            <Setter Property="HeadersVisibility"       Value="Column"/>
            <Setter Property="BorderThickness"         Value="0"/>
            <Setter Property="RowHeight"               Value="40"/>
            <Setter Property="SelectionUnit"           Value="FullRow"/>
        </Style>

        <!-- ── Card border ────────────────────────────────────────────────── -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="8"/>
        </Style>

        <!-- ── Section label ──────────────────────────────────────────────── -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="{DynamicResource SubtextBrush}"/>
            <Setter Property="FontSize"    Value="10"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Margin"      Value="12,12,0,4"/>
        </Style>

        <!-- ── Separator ──────────────────────────────────────────────────── -->
        <Style TargetType="Separator">
            <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Margin"     Value="8,4"/>
        </Style>

    </Window.Resources>

    <!-- ── Root layout: Sidebar + Main ───────────────────────────────────── -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>  <!-- Sidebar -->
            <ColumnDefinition Width="*"/>    <!-- Main content -->
        </Grid.ColumnDefinitions>

        <!-- ════════════════════════════════════════════════════════════════ -->
        <!-- SIDEBAR                                                          -->
        <!-- ════════════════════════════════════════════════════════════════ -->
        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Logo -->
                    <RowDefinition Height="*"/>     <!-- Nav -->
                    <RowDefinition Height="Auto"/>  <!-- Footer -->
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Row="0" Margin="16,20,16,16">
                    <TextBlock Text="💾 EasySave" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="v3.0 — ProSoft" FontSize="11"
                               Foreground="{DynamicResource SubtextBrush}" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Nav -->
                <StackPanel Grid.Row="1" Margin="8,0">

                    <TextBlock Text="JOBS" Style="{StaticResource SectionLabel}"/>

                    <Button Content="＋  New Job" Style="{StaticResource SideBtn}"
                            Click="NewJobButton_Click" IsEnabled="{Binding IsNotBusy}"
                            Foreground="{DynamicResource TextBrush}"/>

                    <Button Content="▶  Run Selected" Style="{StaticResource SideBtn}"
                            Command="{Binding RunSelectedJobsCommand}"
                            Foreground="{DynamicResource TextBrush}"/>

                    <Button Content="▶▶  Run All" Style="{StaticResource SideBtn}"
                            Command="{Binding RunAllJobsCommand}"
                            Foreground="{DynamicResource TextBrush}"/>

                    <Button Content="✕  Delete" Style="{StaticResource SideBtn}"
                            Command="{Binding DeleteJobCommand}"
                            Foreground="{DynamicResource ErrorBrush}"/>

                    <Separator/>

                    <TextBlock Text="PLAYBACK" Style="{StaticResource SectionLabel}"/>

                    <Button Content="▶  Play" Style="{StaticResource SideBtn}"
                            Command="{Binding ResumeJobCommand}"
                            Foreground="#3FB950"/>
                    <Button Content="⏸  Pause" Style="{StaticResource SideBtn}"
                            Command="{Binding PauseJobCommand}"
                            Foreground="{DynamicResource WarningBrush}"/>
                    <Button Content="⏹  Stop" Style="{StaticResource SideBtn}"
                            Command="{Binding StopJobCommand}"
                            Foreground="{DynamicResource ErrorBrush}"/>

                    <Separator/>

                    <TextBlock Text="ALL JOBS" Style="{StaticResource SectionLabel}"/>

                    <Button Content="▶▶  Play All" Style="{StaticResource SideBtn}"
                            Command="{Binding ResumeAllCommand}"
                            Foreground="#3FB950"/>
                    <Button Content="⏸⏸  Pause All" Style="{StaticResource SideBtn}"
                            Command="{Binding PauseAllCommand}"
                            Foreground="{DynamicResource WarningBrush}"/>
                    <Button Content="⏹⏹  Stop All" Style="{StaticResource SideBtn}"
                            Command="{Binding StopAllCommand}"
                            Foreground="{DynamicResource ErrorBrush}"/>
                </StackPanel>

                <!-- Footer -->
                <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0" Padding="8,8">
                    <StackPanel>
                        <Button Content="{Binding CurrentLanguageText}" Style="{StaticResource SideBtn}"
                                Command="{Binding ToggleLanguageCommand}"
                                Foreground="{DynamicResource TextBrush}"
                                ToolTip="Switch language / Changer la langue"/>
                        <Button Content="{Binding ThemeButtonText}" Style="{StaticResource SideBtn}"
                                Command="{Binding ToggleThemeCommand}"
                                Foreground="{DynamicResource TextBrush}"
                                ToolTip="Toggle dark/light theme"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════════════════════════ -->
        <!-- MAIN CONTENT                                                     -->
        <!-- ════════════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>   <!-- Top bar -->
                <RowDefinition Height="*"/>    <!-- Job table -->
                <RowDefinition Height="Auto"/> <!-- Active job detail -->
                <RowDefinition Height="Auto"/> <!-- Settings -->
                <RowDefinition Height="32"/>   <!-- Status bar -->
            </Grid.RowDefinitions>

            <!-- ── Top bar ──────────────────────────────────────────────── -->
            <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="16,0">
                    <TextBlock Text="{Binding StatusMessage}"
                               VerticalAlignment="Center" FontSize="13"
                               Foreground="{DynamicResource SubtextBrush}"/>
                    <!-- Busy spinner indicator -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="● " Foreground="#3FB950" FontSize="10" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding [info_backing_up]}" FontSize="12"
                                   Foreground="{DynamicResource SubtextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Job table ────────────────────────────────────────────── -->
            <Border Grid.Row="1" Margin="16,12,16,0" Style="{StaticResource Card}">
                <DataGrid x:Name="JobsGrid" ItemsSource="{Binding Jobs}"
                          SelectedItem="{Binding SelectedJob}" SelectionChanged="JobsGrid_SelectionChanged"
                          Padding="0">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                               Width="42"/>

                        <DataGridTextColumn Binding="{Binding Name}" Width="180" IsReadOnly="True">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{Binding DataContext.[job_name], RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                           Style="{StaticResource {x:Type TextBlock}}"/>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Binding="{Binding TypeText}" Width="100" IsReadOnly="True">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{Binding DataContext.[job_type], RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                           Style="{StaticResource {x:Type TextBlock}}"/>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="{DynamicResource SubtextBrush}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Binding="{Binding SourceDirectory}" Width="*" IsReadOnly="True">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{Binding DataContext.[job_source], RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                           Style="{StaticResource {x:Type TextBlock}}"/>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="{DynamicResource SubtextBrush}"/>
                                    <Setter Property="FontSize" Value="12"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Binding="{Binding TargetDirectory}" Width="*" IsReadOnly="True">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="{Binding DataContext.[job_target], RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                           Style="{StaticResource {x:Type TextBlock}}"/>
                            </DataGridTextColumn.Header>
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Foreground" Value="{DynamicResource SubtextBrush}"/>
                                    <Setter Property="FontSize" Value="12"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Status badge -->
                        <DataGridTemplateColumn Width="110">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="Status" Style="{StaticResource {x:Type TextBlock}}"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="6,2" Margin="4,6"
                                            HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#1C1C2E"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Active">
                                                        <Setter Property="Background" Value="#14532D"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Paused">
                                                        <Setter Property="Background" Value="#431407"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Error">
                                                        <Setter Property="Background" Value="#450A0A"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                        <Setter Property="Background" Value="#052E16"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource SubtextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Active">
                                                            <Setter Property="Foreground" Value="#4ADE80"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Paused">
                                                            <Setter Property="Foreground" Value="#FB923C"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Error">
                                                            <Setter Property="Foreground" Value="#F87171"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                            <Setter Property="Foreground" Value="#86EFAC"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Progress bar -->
                        <DataGridTemplateColumn Width="160">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="Progress" Style="{StaticResource {x:Type TextBlock}}"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="8,6">
                                        <ProgressBar Value="{Binding Progress}" Maximum="100" Minimum="0"
                                                     Height="6" Background="{DynamicResource Surface2Brush}">
                                            <ProgressBar.Foreground>
                                                <SolidColorBrush Color="#2563EB"/>
                                            </ProgressBar.Foreground>
                                            <ProgressBar.Template>
                                                <ControlTemplate TargetType="ProgressBar">
                                                    <Border CornerRadius="3" Background="{TemplateBinding Background}">
                                                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                                                CornerRadius="3" Background="{TemplateBinding Foreground}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="Value" Value="100">
                                                            <Setter TargetName="PART_Indicator" Property="Background" Value="#16A34A"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ProgressBar.Template>
                                        </ProgressBar>
                                        <TextBlock Text="{Binding Progress, StringFormat={}{0:0}%}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   Margin="0,-14,0,0" FontSize="10"
                                                   Foreground="{DynamicResource SubtextBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- ── Active job detail card ────────────────────────────────── -->
            <Border Grid.Row="2" Margin="16,8,16,0" Padding="14,10"
                    Style="{StaticResource Card}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="ACTIVE JOB" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SubtextBrush}"/>
                        <TextBlock Text="{Binding SelectedJob.Name}" FontWeight="SemiBold" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="FILES REMAINING" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SubtextBrush}"/>
                        <TextBlock Text="{Binding SelectedJob.RemainingFiles}" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="PROGRESS" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource SubtextBrush}"/>
                        <TextBlock Text="{Binding SelectedJob.Progress, StringFormat={}{0:0}%}" Margin="0,2,0,0"
                                   Foreground="#3FB950" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Settings panel ────────────────────────────────────────── -->
            <Expander Grid.Row="3" Margin="16,8,16,4"
                      Background="{DynamicResource SurfaceBrush}"
                      Foreground="{DynamicResource TextBrush}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      BorderThickness="1">
                <Expander.Header>
                    <TextBlock Text="{Binding [menu_settings]}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"/>
                </Expander.Header>
                <WrapPanel Margin="12,8,12,12" Orientation="Horizontal">
                    <!-- Business Software -->
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="{Binding [lbl_business_software]}" FontSize="11"
                                   Foreground="{DynamicResource SubtextBrush}" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding BusinessSoftwareName, UpdateSourceTrigger=PropertyChanged}"
                                 Width="160" ToolTip="Process name (e.g. notepad)"/>
                    </StackPanel>
                    <!-- Encrypt Extensions -->
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="{Binding [lbl_encrypt_extensions]}" FontSize="11"
                                   Foreground="{DynamicResource SubtextBrush}" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding EncryptionExtensions, UpdateSourceTrigger=PropertyChanged}"
                                 Width="160" ToolTip=".docx, .xlsx"/>
                    </StackPanel>
                    <!-- Priority Extensions -->
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="{Binding [lbl_priority_extensions]}" FontSize="11"
                                   Foreground="{DynamicResource SubtextBrush}" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding PriorityExtensions, UpdateSourceTrigger=PropertyChanged}"
                                 Width="140" ToolTip=".txt, .xml"/>
                    </StackPanel>
                    <!-- Large File Ko -->
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="{Binding [lbl_large_file_kb]}" FontSize="11"
                                   Foreground="{DynamicResource SubtextBrush}" Margin="0,0,0,3"/>
                        <TextBox Text="{Binding LargeFileSizeKb, UpdateSourceTrigger=PropertyChanged}"
                                 Width="80" ToolTip="1024"/>
                    </StackPanel>
                    <!-- Log Format -->
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="{Binding [settings_log_format]}" FontSize="11"
                                   Foreground="{DynamicResource SubtextBrush}" Margin="0,0,0,3"/>
                        <ComboBox x:Name="LogFormatCombo" SelectionChanged="LogFormatCombo_SelectionChanged"
                                  SelectedIndex="0" Width="80">
                            <ComboBoxItem Content="JSON"/>
                            <ComboBoxItem Content="XML"/>
                        </ComboBox>
                    </StackPanel>
                    <!-- Save -->
                    <StackPanel VerticalAlignment="Bottom">
                        <Button Content="{Binding [lbl_save]}" Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveSettingsCommand}" Height="30"/>
                    </StackPanel>
                </WrapPanel>
            </Expander>

            <!-- ── Status bar ────────────────────────────────────────────── -->
            <Border Grid.Row="4" Background="{DynamicResource Surface2Brush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                <TextBlock Text="{Binding StatusMessage}" Margin="16,0"
                           VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource SubtextBrush}"/>
            </Border>
        </Grid>
    </Grid>
</Window>
