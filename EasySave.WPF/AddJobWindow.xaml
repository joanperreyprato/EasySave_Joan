<Window x:Class="EasySave.WPF.AddJobWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Job" Height="780" Width="792"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundColor}">
    <Border Margin="24" Style="{StaticResource Card}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock x:Name="TitleText" Text="Add job" Style="{StaticResource SectionHeader}"/>
                <TextBlock x:Name="DescriptionText" Text="Fill in the backup information and log format." Style="{StaticResource DescriptionText}"/>
            </StackPanel>

            <StackPanel Grid.Row="1">
                <TextBlock x:Name="LabelName" Text="Name" Style="{StaticResource ModernLabel}"/>
                <TextBox x:Name="TxtName" Style="{StaticResource ModernTextBox}" Margin="0,0,0,12"/>

                <TextBlock x:Name="LabelSource" Text="Source" Style="{StaticResource ModernLabel}"/>
                <DockPanel Margin="0,0,0,12">
                    <TextBox x:Name="TxtSource" Style="{StaticResource ModernTextBox}" Width="360" VerticalContentAlignment="Center"/>
                    <Button x:Name="BtnBrowseSource" Content="Browse..." Style="{StaticResource SecondaryButton}" Width="100" Height="36" Margin="8,0,0,0" DockPanel.Dock="Right"/>
                </DockPanel>

                <TextBlock x:Name="LabelDestination" Text="Destination" Style="{StaticResource ModernLabel}"/>
                <DockPanel Margin="0,0,0,12">
                    <TextBox x:Name="TxtDestination" Style="{StaticResource ModernTextBox}" Width="360" VerticalContentAlignment="Center"/>
                    <Button x:Name="BtnBrowseDestination" Content="Browse..." Style="{StaticResource SecondaryButton}" Width="100" Height="36" Margin="8,0,0,0" DockPanel.Dock="Right"/>
                </DockPanel>

                <TextBlock x:Name="LabelLog" Text="Log format" Style="{StaticResource ModernLabel}"/>
                <ComboBox x:Name="CbLogFormat" Style="{StaticResource ModernComboBox}" Height="44" Margin="0,0,0,12" PreviewMouseLeftButtonDown="CbLogFormat_PreviewMouseLeftButtonDown">
                    <ComboBoxItem Content="JSON" IsSelected="True"/>
                    <ComboBoxItem Content="XML"/>
                </ComboBox>

                <TextBlock x:Name="LabelType" Text="Type" Style="{StaticResource ModernLabel}"/>
                <ComboBox x:Name="CbBackupType" Style="{StaticResource ModernComboBox}" Height="44" PreviewMouseLeftButtonDown="CbBackupType_PreviewMouseLeftButtonDown">
                    <ComboBoxItem x:Name="CbItemFull" Content="Full" IsSelected="True"/>
                    <ComboBoxItem x:Name="CbItemDifferential" Content="Differential"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource OutlineButton}" Width="120" Height="44" Margin="0,0,12,0"/>
                <Button x:Name="BtnOk" Content="Create" Style="{StaticResource ModernButton}" Width="120" Height="44"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
