<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>EasySave.Core</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EasyLog\EasyLog.csproj" />
	<ProjectReference Include="..\CryptoSoft\CryptoSoft.csproj" />
  </ItemGroup>

  <!-- Exclude UI files from core project; they are compiled into the UI project -->
  <ItemGroup>
    <Compile Remove="Program.cs" />
    <Compile Remove="ConsoleUI.cs" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Examples\" />
  </ItemGroup>

</Project>
